[run]
source = src
omit =
    */tests/*
    */test_*.py
    */notebooks/*
    */data/*
    */models/*
    */checkpoints/*
    */logs/*
    */__pycache__/*
    */venv/*
    */env/*
    */ENV/*
    */.venv/*

[report]
precision = 2
show_missing = True
skip_covered = False

[xml]
output = coverage.xml

