FROM python:3.10-slim

WORKDIR /app

# Install dependencies
RUN pip install --no-cache-dir \
    torch==2.1.0 \
    numpy==1.24.3 \
    pandas==2.1.3 \
    fastapi==0.104.1 \
    uvicorn==0.24.0 \
    pydantic==2.5.0

# Copy models
COPY checkpoints/ /app/checkpoints/
COPY src/models/ /app/src/models/
COPY src/data/ /app/src/data/

# Create a simple API server
RUN echo 'from fastapi import FastAPI, HTTPException\n\
from pydantic import BaseModel\n\
import json\n\
import os\n\
from pathlib import Path\n\
\n\
app = FastAPI(title="WealthArena Models API")\n\
\n\
class PredictionRequest(BaseModel):\n\
    model_type: str\n\
    market_data: dict\n\
\n\
@app.get("/")\n\
async def root():\n\
    return {\n\
        "message": "WealthArena Models API",\n\
        "version": "1.0",\n\
        "available_models": ["asx_stocks", "commodities", "cryptocurrencies", "currency_pairs", "etf"]\n\
    }\n\
\n\
@app.get("/models")\n\
async def list_models():\n\
    """List all available models"""\n\
    models_dir = Path("/app/checkpoints")\n\
    models = [d.name for d in models_dir.iterdir() if d.is_dir()]\n\
    return {"models": models, "count": len(models)}\n\
\n\
@app.get("/models/{model_type}")\n\
async def get_model_info(model_type: str):\n\
    """Get information about a specific model"""\n\
    model_path = Path(f"/app/checkpoints/{model_type}")\n\
    if not model_path.exists():\n\
        raise HTTPException(status_code=404, detail=f"Model {model_type} not found")\n\
    \n\
    # Try to read metadata\n\
    metadata_path = model_path / model_type / "metadata.json"\n\
    config_path = model_path / model_type / "config.json"\n\
    \n\
    info = {"model_type": model_type, "path": str(model_path)}\n\
    \n\
    if metadata_path.exists():\n\
        with open(metadata_path) as f:\n\
            info["metadata"] = json.load(f)\n\
    \n\
    if config_path.exists():\n\
        with open(config_path) as f:\n\
            info["config"] = json.load(f)\n\
    \n\
    return info\n\
\n\
@app.post("/predict")\n\
async def predict(request: PredictionRequest):\n\
    """Make a prediction (placeholder - integrate with actual model)"""\n\
    model_type = request.model_type\n\
    model_path = Path(f"/app/checkpoints/{model_type}")\n\
    \n\
    if not model_path.exists():\n\
        raise HTTPException(status_code=404, detail=f"Model {model_type} not found")\n\
    \n\
    # TODO: Load model and make actual prediction\n\
    # For now, return a placeholder response\n\
    return {\n\
        "model_type": model_type,\n\
        "prediction": "hold",\n\
        "confidence": 0.75,\n\
        "note": "This is a placeholder. Integrate actual model inference."\n\
    }\n\
\n\
@app.get("/health")\n\
async def health():\n\
    return {"status": "healthy", "models_loaded": True}\n\
' > /app/api_server.py

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"

# Run the API server
CMD ["uvicorn", "api_server:app", "--host", "0.0.0.0", "--port", "8000"]

